# Polelo — Environment Configuration
# Copy to .env and customize

# App
DEBUG=false
JWT_SECRET=change-me-in-production

# Database
DATABASE_URL=postgresql://postgres:password@localhost/polelo
DB_POOL_MIN=1
DB_POOL_MAX=10

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=polelo-snapshots

# CORS (comma-separated origins)
CORS_ORIGINS=*

# Rate limiting (requests per minute per role)
RATE_LIMIT_LEARNER=60
RATE_LIMIT_TRANSLATOR=120
RATE_LIMIT_REVIEWER=120
RATE_LIMIT_TEACHER=120
RATE_LIMIT_ADMIN=300

# API keys for internal AI workers (comma-separated)
API_KEYS=

# Moodle integration (comma-separated keys, one per Moodle instance)
MOODLE_API_KEYS=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
