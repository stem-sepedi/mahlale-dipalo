# Polelo — Environment Configuration
# Copy to .env and customize

# App
DEBUG=false
JWT_SECRET=change-me-in-production

# Database
DATABASE_URL=postgresql://postgres:password@localhost/polelo
DB_POOL_MIN=1
DB_POOL_MAX=10

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=polelo-snapshots

# CORS (comma-separated origins)
CORS_ORIGINS=*

# Rate limiting (requests per minute per role)
RATE_LIMIT_LEARNER=60
RATE_LIMIT_TRANSLATOR=120
RATE_LIMIT_REVIEWER=120
RATE_LIMIT_TEACHER=120
RATE_LIMIT_ADMIN=300

# API keys for internal AI workers (comma-separated)
API_KEYS=

# Moodle integration (comma-separated keys, one per Moodle instance)
MOODLE_API_KEYS=
# Secret used by the local_polelo Moodle plugin to call the content API
MoodleApiKey=
# Shared secrets for Moodle webhook signing (comma-separated, one per instance)
MoodleWebhookSecret=
# Secret used to sign LTI 1.3 JWTs for the tool provider
MoodleLtiSecret=

# Embedded widgets
# Public base URL the embed pages/widgets resolve (e.g. https://polelo.taip.co.za)
EMBED_BASE_URL=
# Origins allowed to frame /embed/* pages (comma-separated, or * for any)
EMBED_ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
